{
    "name": "trsoftech/tr-wordpress-ai-toolkit",
    "description": "Connect AI assistants to WordPress via the Model Context Protocol using the official WordPress MCP Adapter.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "True Response Softech Pvt. Ltd.",
            "email": "info@trsoftech.com",
            "homepage": "https://trsoftech.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0",
        "wp-phpunit/wp-phpunit": "^6.5",
        "yoast/phpunit-polyfills": "^2.0",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "classmap": [
            "includes/",
            "modules/",
            "admin/",
            "integrations/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TRSoftech\\AIToolkit\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "lint": "phpcs --standard=WordPress --extensions=php includes/ modules/ admin/ integrations/ tr-wordpress-ai-toolkit.php",
        "lint-fix": "phpcbf --standard=WordPress --extensions=php includes/ modules/ admin/ integrations/ tr-wordpress-ai-toolkit.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
